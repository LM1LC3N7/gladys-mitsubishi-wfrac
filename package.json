{
  "name": "gladys-mitsubishi-wfrac",
  "version": "0.1.2",
  "private": true,
  "description": "Gladys Assistant external integration for Mitsubishi Heavy Industries air conditioners with the WF-RAC Wi-Fi adapter: on/off, mode, setpoint, fan, vane, indoor and outdoor temperatures, over the local API of the adapter. Unofficial, not affiliated with Mitsubishi Heavy Industries.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
